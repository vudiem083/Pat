# BAT — Bedrock Agent Toolkit configuration
# Copy to .env and edit. Never commit the real .env file.

# ---------------------------------------------------------------------------
# Storage locations (absolute paths or paths relative to the process cwd)
# ---------------------------------------------------------------------------
# Project data, artifacts and job logs
BAT_WORKSPACE=./data
# Runtime environments, sessions, incidents, snapshots and cache
BAT_RUNTIME_ROOT=./runtime
# SQLite database (defaults to $BAT_WORKSPACE/bat.db)
# BAT_DATABASE=./data/bat.db

# ---------------------------------------------------------------------------
# REST API
# ---------------------------------------------------------------------------
BAT_HOST=127.0.0.1
BAT_PORT=8000
# When set, every /api/v1 request must send it as "X-API-Key: <value>" or
# "Authorization: Bearer <value>". Leave empty to disable authentication
# (recommended only for localhost development).
BAT_API_KEY=

# ---------------------------------------------------------------------------
# Runtime adapter
# ---------------------------------------------------------------------------
# "bds"   -> run an operator-supplied Bedrock Dedicated Server executable
# "auto"  -> use bds when a server executable is found, otherwise report the
#            runtime as unavailable (never fakes a successful test)
BAT_RUNTIME_ADAPTER=auto
# Path to the operator-supplied bedrock_server executable.
# BAT does not download, bundle or redistribute Minecraft server binaries.
BAT_BEDROCK_SERVER=
# Seconds to wait for the server to report readiness before failing the job.
BAT_SERVER_START_TIMEOUT=120
# Seconds between heartbeat writes while a runtime server is running.
BAT_HEARTBEAT_INTERVAL=5
# If a live server produces no output for this many seconds, BAT records an
# UNRESPONSIVE incident (it does not treat this as a crash).
BAT_UNRESPONSIVE_SECONDS=90

# ---------------------------------------------------------------------------
# Limits and safety
# ---------------------------------------------------------------------------
BAT_MAX_FILE_BYTES=10485760
BAT_MAX_UPLOAD_BYTES=52428800
# BAT's own structured log directory (defaults to $BAT_WORKSPACE/logs)
# BAT_LOG_ROOT=./data/logs
BAT_LOG_MAX_BYTES=2097152
BAT_LOG_BACKUP_COUNT=5
BAT_JOB_WORKERS=4
BAT_DEFAULT_WAIT_SECONDS=30
BAT_MAX_WAIT_SECONDS=300
